task.spawn(function()
    local getAsset = getcustomasset or getsynasset
    if not (getAsset and writefile) then
        warn("[NOX] executor has no getcustomasset/writefile - cannot load the edit")
        notify("Executor can't load the edit.")
        return
    end

    -- writes the file once; later runs reuse it (faster start)
    local function ensureFile(name, b64)
        local exists = false
        if isfile then
            local okF, r = pcall(isfile, name)
            exists = okF and r and true or false
        end
        if not exists then writefile(name, b64decode(b64, 4000)) end
        return getAsset(name)
    end

    pcall(function() poster.Image = ensureFile(POSTER_FILE, POSTER_B64) end)
    local okV, errV = pcall(function() video.Video = ensureFile(VIDEO_FILE, VIDEO_B64) end)
    local okM, errM = pcall(function() sound.SoundId = ensureFile(MUSIC_FILE, MUSIC_B64) end)
    if not okV then warn("[NOX] video failed: " .. tostring(errV)) end
    if not okM then warn("[NOX] music failed: " .. tostring(errM)) end

    -- wait until both are ready (max 20s), then start them together
    local vLoaded, mLoaded = false, false
    local t0 = tick()
    while tick() - t0 < 20 do
        local a, v = pcall(function() return video.IsLoaded end)
        vLoaded = okV and a and v and true or false
        local b, m = pcall(function() return sound.IsLoaded end)
        mLoaded = okM and b and m and true or false
        if (vLoaded or not okV) and (mLoaded or not okM) then break end
        task.wait(0.2)
    end

    videoOk = vLoaded
    pcall(function()
        if vLoaded then video.TimePosition = 0; video:Play() end
        if mLoaded and musicOn then sound.TimePosition = 0; sound:Play() end
    end)
    mediaReady = true

    if vLoaded then
        notify("Edit playing.")
    else
        notify("Video unsupported - showing still frame.")
    end

    -- keep music locked to the video (fixes any drift, and replays after the loop)
    while gui.Parent do
        task.wait(1)
        if vLoaded and mLoaded and musicOn then
            pcall(function()
                if math.abs(sound.TimePosition - video.TimePosition) > 0.3 then
                    sound.TimePosition = video.TimePosition
                end
                if not sound.IsPlaying then sound:Play() end
                if not video.Playing and main.Visible then video:Play() end
            end)
        end
    end
end)

